# Server
PORT=5000

# Database (MongoDB)
# Local:  mongodb://127.0.0.1:27017/ecoalert
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/ecoalert
MONGODB_URI=mongodb://127.0.0.1:27017/ecoalert

# Auth (JWT)
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
# The frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Admin bootstrap
# Comma-separated emails that are always treated as admins
# Keep in sync with src/config/admin.js on the frontend.
ADMIN_EMAILS=femohammed@st.ug.edu.gh
