rules_version = '2';

// EcoAlert Firestore Security Rules
//
// Admin model (mirrors src/config/admin.js):
//   A user is an admin if their users/{uid} doc has role == 'admin',
//   OR their auth email matches the bootstrap owner email below.
//   Keep BOOTSTRAP_ADMIN_EMAIL in sync with ADMIN_EMAILS in src/config/admin.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Bootstrap owner — lets the first admin in before any role is set.
        request.auth.token.email == 'femohammed@st.ug.edu.gh' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── Users ───
    match /users/{userId} {
      // Read your own profile; admins can read & list everyone.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Create only your own user document.
      allow create: if isOwner(userId);

      // Owners may update their own doc but may NOT change their own `role`
      // (prevents self-promotion). Admins may update any user document.
      allow update: if isAdmin() ||
        (isOwner(userId) && !affected().hasAny(['role']));

      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }

    // ─── Reports ───
    match /reports/{reportId} {
      // Any signed-in user can read reports (map, dashboard, admin).
      allow read: if isSignedIn();

      // Create a report owned by yourself.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Update allowed for:
      //  - admins (moderation / status changes),
      //  - the report owner (editing their own report),
      //  - any signed-in user, but ONLY for community fields (upvote/verify/comment).
      allow update: if isAdmin() ||
        isOwner(resource.data.userId) ||
        (isSignedIn() && affected().hasOnly(
          ['upvotes', 'downvotes', 'verificationCount', 'comments', 'updatedAt']
        ));

      // Delete allowed for the report owner or an admin.
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // ─── Waste tracking ───
    match /waste_tracking/{trackingId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // ─── Default deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
