rules_version = '2';

// EcoAlert Cloud Storage Security Rules
// Images are stored under reports/{uid}/... and profile_pictures/{uid}/...

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    // Report photos — publicly readable, owner-writable.
    match /reports/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // Profile pictures — publicly readable, owner-writable.
    match /profile_pictures/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
